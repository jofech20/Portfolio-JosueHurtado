---
interface Props { pasos: string[] }
const items = Astro.props.pasos.map((p) => {
  const [i, ...t] = p.split(':');
  return { i, t: t.join(':') };
});
---
<ol class="pipe">
  {items.map((x, n) => (
    <li style={`--i:${n}`}>
      <span class="pipe__ico"><svg aria-hidden="true"><use href={`#i-${x.i}`} /></svg></span>
      <span class="pipe__t">{x.t}</span>
    </li>
  ))}
</ol>
