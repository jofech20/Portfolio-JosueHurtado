---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Iconos from '../components/Iconos.astro';
import Pipe from '../components/Pipe.astro';
import Diagrama from '../components/Diagrama.astro';
import { sitio, experiencia, formacion } from '../data/sitio';
import { proyectos, casos, areas, estados, stackConteo } from '../data/proyectos';

const enProduccion = proyectos.filter((p) => p.estado === 'En uso' || p.estado === 'Desplegado').length;
const plataformas = 4;
const pestanas = [
  ['inicio', 'Inicio'], ['metodo', 'Método'], ['casos', 'Casos'], ['indice', 'Índice'],
  ['stack', 'Stack'], ['trayectoria', 'Trayectoria'], ['contacto', 'Contacto'],
];
const fila1 = ['J', 'O', 'S', 'U', 'É'];
const fila2 = ['H', 'U', 'R', 'T', 'A', 'D', 'O'];
const columnas = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
const maxStack = Math.max(...stackConteo.map((s) => s.n));
const asas = ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'];
const clase = (e: string) => 'estado estado--' + e.toLowerCase().replace(/[^a-z]/g, '');
const externo = { target: '_blank', rel: 'noopener' };
const jsonld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Person', name: 'Josué Hurtado',
  jobTitle: sitio.titulo, address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' },
  knowsAbout: ['Automatización de procesos', 'Python', 'VBA', 'Google Apps Script', 'Power Platform'],
  sameAs: [sitio.linkedin, sitio.invita].filter(Boolean),
  url: Astro.site?.href,
});
---
<html lang="es">
<head>
  <title>Josué Hurtado</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="claude:viewport-fit-sides" content="cover" />
  <meta name="description" content={sitio.descripcion} />
  <meta property="og:title" content={`${sitio.nombre} · ${sitio.titulo}`} />
  <meta property="og:description" content={sitio.descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.site?.href} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" as="image" href="/josue.webp" />
  <script type="application/ld+json" set:html={jsonld}></script>
</head>
<body>
  <Iconos />
  <a class="saltar" href="#casos">Saltar a los proyectos</a>

  <header class="barra" aria-label="Barra de fórmulas">
    <a class="barra__nombre" href="#inicio" id="barra-ref">A1</a>
    <span class="barra__fx" aria-hidden="true">fx</span>
    <output class="barra__formula" id="barra-formula">=CONCATENAR("Josué"; " "; "Hurtado")</output>
    {sitio.linkedin && <a class="barra__link" href={sitio.linkedin} {...externo} aria-label="LinkedIn de Josué Hurtado"><span class="ln-largo">LinkedIn</span><span class="ln-corto">in</span> ↗</a>}
  </header>

  <main>
    <section class="hero" id="inicio" data-ref="A1" data-formula={'=CONCATENAR("Josué"; " "; "Hurtado")'}>
      <div class="hoja">
        <h1 class="sr">{sitio.nombre}. {sitio.titulo}.</h1>
        <div class="hero__grid">
          <div class="hero__izq">
            <div class="celdas" aria-hidden="true" id="celdas">
              <div class="esquina"></div>
              {columnas.map((c) => <div class="col" data-c={c}>{c}</div>)}
              <div class="fil" data-r="1">1</div>
              {fila1.map((l, i) => <div class="celda celda--letra" data-c={columnas[i]} data-r="1"><span class="letra">{l}</span></div>)}
              <div class="celda celda--dato" data-c="F" data-r="1"><span>{sitio.ubicacion}</span></div>
              <div class="celda celda--dato" data-c="G" data-r="1"><span>Abierto a oportunidades</span></div>
              <div class="fil" data-r="2">2</div>
              {fila2.map((l, i) => <div class="celda celda--letra" data-c={columnas[i]} data-r="2"><span class="letra">{l}</span></div>)}
              <div class="seleccion" id="seleccion"><i></i></div>
            </div>
            <div class="hero__pie">
              <p class="hero__tesis">{sitio.titulo}.</p>
              <div class="hero__texto">
                <p>Convierto tareas manuales en Excel, Word y correo en herramientas para RR. HH., ventas y operaciones. Trabajo con Python, VBA, Apps Script y Power Platform.</p>
                <p class="fundador"><span class="estado estado--desplegado">En línea</span> Fundador de <a href={sitio.invita} {...externo}>Invita+ Studio ↗</a></p>
                <div class="acciones">
                  <a class="boton boton--lleno" href="#casos">Ver casos</a>
                  <a class="boton" href="#contacto">Escribirme</a>
                  {sitio.linkedin && <a class="boton" href={sitio.linkedin} {...externo}>LinkedIn ↗</a>}
                </div>
              </div>
              <dl class="cifras">
                <div><dt>Proyectos</dt><dd data-contar={proyectos.length}>{proyectos.length}</dd></div>
                <div><dt>En producción</dt><dd data-contar={enProduccion}>{enProduccion}</dd></div>
                <div><dt>Plataformas</dt><dd data-contar={plataformas}>{plataformas}</dd></div>
              </dl>
            </div>
          </div>
          <figure class="retrato" id="retrato">
            <div class="retrato__marco">
              <canvas class="lluvia" id="lluvia-hero" aria-hidden="true"></canvas>
              <img src="/josue.webp" alt="Retrato de Josué Hurtado" width="860" height="1026" fetchpriority="high" />
              <div class="retrato__scan" aria-hidden="true"></div>
              <span class="retrato__tag" aria-hidden="true">H1 · josue.webp</span>
              <p class="retrato__linea" aria-hidden="true"><span class="prompt">&gt;</span> <span id="tipeo">automatizando procesos</span><i class="cursor"></i></p>
            </div>
            {asas.map((a) => <span class={`asa asa--${a}`} aria-hidden="true"></span>)}
          </figure>
        </div>
      </div>
    </section>

    <section class="metodo" id="metodo" data-ref="B2" data-formula={'=GENERAR(fila; plantilla; "PDF")'}>
      <div class="metodo__fijo" id="metodo-fijo">
        <div class="tope">
          <h2>Una fila entra. Un documento sale.</h2>
          <p class="nota">Datos de ejemplo</p>
        </div>
        <div class="escena" id="escena">
          <div class="escena__izq">
            <div class="tabla-demo" id="tabla-demo">
              <div class="td td--cab"><span>DNI</span><span>Nombre</span><span>Cargo</span><span>Monto</span></div>
              <div class="td"><span>41208867</span><span>Luis Ramos</span><span>Supervisor</span><span>4500</span></div>
              <div class="td td--activa" id="fila-activa">
                <span class="doble" id="c-dni"><b class="sucio">7654321</b><b class="limpio">07654321</b></span>
                <span class="doble" id="c-nom"><b class="sucio">ana  TORRES</b><b class="limpio">Ana Torres</b></span>
                <span id="c-car">Analista</span>
                <span class="doble" id="c-mon"><b class="sucio">3200</b><b class="limpio">S/ 3,200.00</b></span>
              </div>
              <div class="td"><span>20917345</span><span>Marta Quispe</span><span>Asistente</span><span>2800</span></div>
            </div>
            <ol class="pasos" id="pasos">
              <li><b>Lee</b> la fila que toca procesar.</li>
              <li><b>Valida</b> el DNI, el nombre y el formato del monto.</li>
              <li><b>Llena</b> la plantilla con cada campo.</li>
              <li><b>Exporta</b> un PDF con nombre único.</li>
            </ol>
          </div>
          <article class="doc" id="doc" aria-label="Carta generada de ejemplo">
            <p class="doc__tit">Carta de ajuste</p>
            <p>Estimada <span class="campo" id="d-nom"><i>{'{{ nombre }}'}</i><b>Ana Torres</b></span>, identificada con DNI <span class="campo" id="d-dni"><i>{'{{ dni }}'}</i><b>07654321</b></span>:</p>
            <p>Te informamos que, en tu cargo de <span class="campo" id="d-car"><i>{'{{ cargo }}'}</i><b>Analista</b></span>, tu nueva remuneración será de <span class="campo" id="d-mon"><i>{'{{ monto }}'}</i><b>S/ 3,200.00</b></span>.</p>
            <p class="doc__fir">Recursos Humanos</p>
            <p class="doc__sello" id="sello">07654321_carta.pdf</p>
          </article>
          <div class="fichas" id="fichas" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="seccion" id="casos" data-ref="C3" data-formula={'=FILTRAR(proyectos; destacado=VERDADERO)'}>
      <div class="tope">
        <h2>Casos destacados</h2>
        <p class="nota">Cada diagrama muestra cómo funciona la herramienta</p>
      </div>
      {casos.map((p) => (
        <article class="caso" id={p.id} data-ref="C3" data-formula={`=CASO("${p.nombre}")`}>
          <header class="caso__cab">
            <p class="caso__meta"><span>{p.area}</span><span class={clase(p.estado)}>{p.estado}</span></p>
            <h3>{p.nombre}</h3>
            <p class="caso__stack">{p.stack.join(' · ')}</p>
            {p.url && <a class="boton boton--lleno vivo" href={p.url} {...externo}>Ver sitio en vivo ↗</a>}
            <Diagrama id={p.id} titulo={`Diagrama animado de cómo funciona ${p.nombre}`} />
          </header>
          <dl class="registro">
            <div><dt>Problema</dt><dd>{p.caso!.problema}</dd></div>
            <div><dt>Solución</dt><dd>{p.caso!.solucion}</dd></div>
            <div><dt>Flujo</dt><dd><Pipe pasos={p.flujo} /></dd></div>
            <div><dt>Decisiones</dt><dd><ul class="decisiones">{p.caso!.decisiones.map((d) => <li>{d}</li>)}</ul></dd></div>
            <div><dt>En cifras</dt><dd class="datos">
              {p.caso!.datos.map((d) => <p><strong>{d.valor}</strong><span>{d.etiqueta}</span></p>)}
            </dd></div>
          </dl>
        </article>
      ))}
    </section>

    <section class="seccion" id="indice" data-ref="D4" data-formula={`=CONTARA(proyectos) → ${proyectos.length}`}>
      <div class="tope">
        <h2>Índice de proyectos</h2>
        <p class="nota"><span id="conteo">{proyectos.length}</span> de {proyectos.length} filas · abre una fila para ver su flujo</p>
      </div>
      <div class="filtros">
        <div class="chips" role="group" aria-label="Filtrar por área">
          <button class="chip" aria-pressed="true" data-area="">Todos</button>
          {areas.map((a) => <button class="chip" aria-pressed="false" data-area={a}>{a}</button>)}
        </div>
        <div class="filtros__campos">
          <label class="campo-f"><span>Estado</span>
            <select id="f-estado"><option value="">Todos</option>{estados.map((e) => <option>{e}</option>)}</select>
          </label>
          <label class="campo-f"><span>Buscar</span>
            <input id="f-buscar" type="search" placeholder="Python, PDF, Power Apps" autocomplete="off" />
          </label>
        </div>
      </div>
      <div class="lista" id="lista">
        <div class="lista__cab" aria-hidden="true"><span>Proyecto</span><span>Área</span><span>Stack</span><span>Estado</span></div>
        {proyectos.map((p) => (
          <details class="fila" data-area={p.area} data-estado={p.estado} data-buscar={`${p.nombre} ${p.resumen} ${p.stack.join(' ')}`.toLowerCase()}>
            <summary>
              <span class="fila__nom">{p.nombre}</span>
              <span class="fila__area">{p.area}</span>
              <span class="fila__stack">{p.stack.slice(0, 3).join(' · ')}</span>
              <span class={clase(p.estado)}>{p.estado}</span>
            </summary>
            <div class="fila__mas">
              <Pipe pasos={p.flujo} />
              <div class="fila__txt">
                <p>{p.resumen}</p>
                <p class="fila__todo">{p.stack.join(' · ')}</p>
                <p class="fila__links">
                  {p.caso && <a href={`#${p.id}`}>Leer el caso completo</a>}
                  {p.url && <a href={p.url} {...externo}>Ver sitio en vivo ↗</a>}
                </p>
              </div>
            </div>
          </details>
        ))}
        <p class="vacio" id="vacio" hidden>Ninguna fila coincide. <button id="limpiar">Quitar filtros</button></p>
      </div>
    </section>

    <section class="seccion" id="stack" data-ref="E5" data-formula={'=CONTAR.SI(proyectos; "Python")'}>
      <div class="tope">
        <h2>Stack con evidencia</h2>
        <p class="nota">Cada barra cuenta proyectos reales. Pulsa una fila para verlos en el índice.</p>
      </div>
      <ul class="barras">
        {stackConteo.map((s) => (
          <li><button data-tec={s.nombre}>
            <span class="barras__n">{s.nombre}</span>
            <span class="barras__b" aria-hidden="true"><i style={`--p:${s.n / maxStack}`}></i></span>
            <span class="barras__c">{s.n}</span>
          </button></li>
        ))}
      </ul>
    </section>

    <section class="seccion" id="trayectoria" data-ref="F6" data-formula={'=ORDENAR(experiencia; fecha; -1)'}>
      <div class="tope"><h2>Trayectoria</h2></div>
      <div class="tray">
        <ol class="exp">
          {experiencia.map((e) => (
            <li>
              <p class="exp__fecha">{e.fecha}</p>
              <h3>{e.cargo}</h3>
              <p class="exp__lugar">{e.lugar}</p>
              <p>{e.texto}</p>
              {e.url && <a class="exp__url" href={e.url} {...externo}>{e.url.replace('https://', '').replace(/\/$/, '')} ↗</a>}
            </li>
          ))}
        </ol>
        <aside class="form">
          <h3>Formación</h3>
          <ul>{formacion.map((f) => <li><b>{f.nombre}</b><span>{f.detalle}</span></li>)}</ul>
        </aside>
      </div>
    </section>

    <section class="contacto" id="contacto" data-ref="G7" data-formula={`=HIPERVINCULO("mailto:${sitio.correo}"; "Escribir")`}>
      <canvas class="lluvia lluvia--contacto" id="lluvia-contacto" aria-hidden="true"></canvas>
      <div class="contacto__in">
        <h2>¿Tienes un proceso que se repite cada semana?</h2>
        <p>Cuéntame cómo se hace hoy. Conversemos sobre un puesto o un proyecto de automatización.</p>
        <div class="correo">
          <a href={`mailto:${sitio.correo}`} id="correo">{sitio.correo}</a>
          <button class="boton" id="copiar" data-correo={sitio.correo}>Copiar correo</button>
        </div>
        <p class="enlaces">
          {sitio.linkedin && <a class="boton" href={sitio.linkedin} {...externo}>LinkedIn ↗</a>}
          {sitio.invita && <a class="boton" href={sitio.invita} {...externo}>Invita+ Studio ↗</a>}
          {sitio.github && <a class="boton" href={sitio.github} {...externo}>GitHub ↗</a>}
        </p>
        <p class="pie">Los proyectos se describen sin nombres de empresas ni datos internos.</p>
      </div>
    </section>
  </main>

  <nav class="pestanas" aria-label="Secciones">
    {pestanas.map(([id, t], i) => <a href={`#${id}`} data-tab={id} aria-current={i === 0 ? 'true' : undefined}>{t}</a>)}
    <span class="pestanas__ind" aria-hidden="true"></span>
  </nav>

  <script src="../scripts/main.ts"></script>
</body>
</html>
